# TLS RFC-compliance detection rules
# sid range: 1000000-1000999

# client_random == server_random (never happens in a legit handshake)
# ref: RFC 8446 §4.1.2 (ClientHello.random) / §4.1.3 (ServerHello.random)
alert tls any any -> any any (msg:"TLS client and server random are identical"; \
    flow:established,to_client; \
    tls.random_reused; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8446; \
    sid:1000001; rev:1;)

# duplicate extension types within a single Hello's extension block
# ref: RFC 8446 §4.2 (no more than one extension of a given type per Hello)
alert tls any any -> any any (msg:"TLS duplicate extension types in Hello"; \
    flow:established; \
    app-layer-event:tls.duplicate_extensions; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8446#section-4.2; \
    sid:1000002; rev:1;)

# server negotiated/echoed a GREASE extension value
# ref: RFC 8701 §3 (client MUST reject a GREASE value in any ServerHello extension)
alert tls any any -> any any (msg:"TLS server negotiated GREASE extension"; \
    flow:established,to_client; \
    app-layer-event:tls.server_negotiated_grease_extension; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8701#section-3; \
    sid:1000003; rev:1;)

# server sent an extension the client never offered
# ref: RFC 8446 §4.2 (server MUST NOT send an extension client did not first offer)
alert tls any any -> any any (msg:"TLS server sent unproposed extension"; \
    flow:established,to_client; \
    app-layer-event:tls.unproposed_extension; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8446#section-4.2; \
    sid:1000004; rev:1;)

# server sent signature_algorithms, a client-only extension
# ref: RFC 8446 §4.2.3 (signature_algorithms MUST NOT appear in ServerHello/EncryptedExtensions)
alert tls any any -> any any (msg:"TLS server sent disallowed signature_algorithms extension"; \
    flow:established,to_client; \
    app-layer-event:tls.server_invalid_signature_algorithms; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8446#section-4.2.3; \
    sid:1000005; rev:1;)

# pre_shared_key extension present but not the last extension in ClientHello
# ref: RFC 8446 §4.2.11 (pre_shared_key MUST be the last extension in ClientHello)
alert tls any any -> any any (msg:"TLS pre_shared_key extension not last in ClientHello"; \
    flow:established,to_server; \
    app-layer-event:tls.psk_not_last_extension; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8446#section-4.2.11; \
    sid:1000006; rev:1;)

# max_fragment_length extension value outside RFC 6066 §4 defined range (1-4)
# ref: RFC 6066 §4
alert tls any any -> any any (msg:"TLS max_fragment_length value out of RFC range"; \
    flow:established; \
    app-layer-event:tls.invalid_max_fragment_length; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-4; \
    sid:1000007; rev:1;)

# server responded with a legal but different max_fragment_length value
# than the one requested by the client
# ref: RFC 6066 §4
alert tls any any -> any any (msg:"TLS server negotiated unrequested max_fragment_length"; \
    flow:established,to_client; \
    app-layer-event:tls.unrequested_max_fragment_length; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-4; \
    sid:1000008; rev:1;)

# server selected a cipher suite the client never offered
# ref: RFC 5246 §7.4.1.3 / RFC 8446 §4.1.3
alert tls any any -> any any (msg:"TLS server selected unproposed cipher suite"; \
    flow:established,to_client; \
    app-layer-event:tls.unproposed_cipher_suite; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8446#section-4.1.3; \
    sid:1000009; rev:1;)

# server negotiated a GREASE value as its selected cipher suite
# ref: RFC 8701 §3
alert tls any any -> any any (msg:"TLS server negotiated GREASE cipher suite"; \
    flow:established,to_client; \
    app-layer-event:tls.server_negotiated_grease_cipher_suite; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc8701#section-3; \
    sid:1000010; rev:1;)

# server selected an RC4 cipher suite
# ref: RFC 7465 §2 (rule 2: server MUST NOT select RC4)
alert tls any any -> any any (msg:"TLS server negotiated RC4 cipher suite"; \
    flow:established,to_client; \
    app-layer-event:tls.server_negotiated_rc4_cipher_suite; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc7465#section-2; \
    sid:1000011; rev:1;)

# client's cipher suite list consisted exclusively of RC4 cipher suites
# ref: RFC 7465 §2 (rule 3: if client only offers RC4, server MUST terminate)
alert tls any any -> any any (msg:"TLS client cipher suites list is RC4-only"; \
    flow:established,to_server; \
    app-layer-event:tls.client_cipher_suites_rc4_only; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc7465#section-2; \
    sid:1000012; rev:1;)

# client proposed at least one RC4 cipher suite
# ref: RFC 7465 §2 (rule 1: client MUST NOT include RC4 in ClientHello)
alert tls any any -> any any (msg:"TLS client proposed RC4 cipher suite"; \
    flow:established,to_server; \
    app-layer-event:tls.client_proposed_rc4_cipher_suite; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc7465#section-2; \
    sid:1000013; rev:1;)

# server sent an unrequested status_request (OCSP stapling) extension
# ref: RFC 6066 §8 (server MUST NOT send status_request unless offered by client)
alert tls any any -> any any (msg:"TLS server sent unrequested status_request extension"; \
    flow:established,to_client; \
    app-layer-event:tls.server_unrequested_status_request_extension; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-8; \
    sid:1000014; rev:1;)

# client sent a padding extension whose extension_data is not all zero bytes
# ref: RFC 7685 §3 (client MUST fill the padding extension completely with zero bytes)
alert tls any any -> any any (msg:"TLS client sent non-zero padding extension content"; \
    flow:established,to_server; \
    app-layer-event:tls.invalid_padding_extension; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc7685#section-3; \
    sid:1000015; rev:1;)

# server echoed the padding extension in its ServerHello
# ref: RFC 7685 §3 (server MUST NOT echo the extension)
alert tls any any -> any any (msg:"TLS server echoed padding extension"; \
    flow:established,to_client; \
    app-layer-event:tls.padding_extension_echoed; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc7685#section-3; \
    sid:1000016; rev:1;)

# client sent an SNI extension with an invalid hostname length
# (must be 1-255 bytes per RFC 6066 §3, bounded by max DNS name length)
alert tls any any -> any any (msg:"TLS client SNI extension invalid length"; \
    flow:established,to_server; \
    app-layer-event:tls.invalid_sni_length; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-3; \
    sid:1000017; rev:1;)

# server included a non-empty SNI extension in its ServerHello
# ref: RFC 6066 §3 ("extension_data" field of this extension SHALL be empty)
alert tls any any -> any any (msg:"TLS server SNI extension length not zero"; \
    flow:established,to_client; \
    app-layer-event:tls.server_sni_length_not_zero; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-3; \
    sid:1000018; rev:1;)

# server included an SNI extension in a resumed session's ServerHello
# ref: RFC 6066 §3 (server MUST NOT include a server_name extension
# in the server hello when resuming a session)
alert tls any any -> any any (msg:"TLS server SNI extension present in resumed session"; \
    flow:established,to_client; \
    app-layer-event:tls.sni_in_resumed_session; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-3; \
    sid:1000019; rev:1;)

# client sent an SNI hostname that violates RFC 6066 §3 format rules
# (literal IP address, trailing dot, or non-ASCII characters)
alert tls any any -> any any (msg:"TLS client SNI hostname invalid format"; \
    flow:established,to_server; \
    app-layer-event:tls.invalid_hostname_format; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6066#section-3; \
    sid:1000020; rev:1;)

# server replied with a SERVER-HELLO record using the SSLv2 record
# format, i.e. it actually negotiated SSLv2 despite RFC 6176 §3
# prohibiting TLS servers from completing an SSL 2.0 handshake
alert tls any any -> any any (msg:"TLS server negotiated SSLv2 SERVER-HELLO - RFC6176 violation"; \
    flow:established,to_client; \
    ssl_state:server_hello; \
    tls.version:sslv2; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6176#section-3; \
    sid:1000021; rev:1;)


    # ===== SSLv2-format ClientHello detection (RFC 6176 §3, client-side ban) =====
# client sent a ClientHello using the SSLv2 record format - either the
# 2-byte header (no padding) or 3-byte header (padding) variant - which
# RFC 6176 §3 prohibits regardless of the version number declared inside
# (pure SSLv2 and the backward-compatible variant are both covered)

# --- 2-byte header variant: input[0] bit7=1, msg-type sits at offset 2 ---
alert tcp any any -> any any (msg:"TLS client sent SSLv2-format ClientHello (2-byte header) - RFC6176 violation"; \
    flow:established,to_server; \
    flowbits:isnotset,ssl2.hello.checked; \
    byte_test:1,&,0x80,0; \
    content:"|01|"; depth:1; offset:2; \
    flowbits:set,ssl2.hello.checked; \
    flowbits:set,ssl2.hello.violation; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6176#section-3; \
    sid:1000022; rev:1;)

# --- 3-byte header variant: input[0] bit7=0, msg-type sits at offset 3 ---
alert tcp any any -> any any (msg:"TLS client sent SSLv2-format ClientHello (3-byte header) - RFC6176 violation"; \
    flow:established,to_server; \
    flowbits:isnotset,ssl2.hello.checked; \
    byte_test:1,&,0x80,0,relative,!0; \
    content:"|01|"; depth:1; offset:3; \
    flowbits:set,ssl2.hello.checked; \
    flowbits:set,ssl2.hello.violation; \
    classtype:protocol-command-decode; \
    reference:url,datatracker.ietf.org/doc/html/rfc6176#section-3; \
    sid:1000023; rev:1;)

# --- fallback: mark "checked" even when neither variant matched, so we
# never re-evaluate this flow's later packets once the first to_server
# payload has been inspected ---
alert tcp any any -> any any (msg:"ssl2 hello check done - no match"; \
    flow:established,to_server; \
    flowbits:isnotset,ssl2.hello.checked; \
    flowbits:set,ssl2.hello.checked; \
    noalert; \
    sid:1000024; rev:1;)